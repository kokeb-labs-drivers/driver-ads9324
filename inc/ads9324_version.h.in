 */
#ifndef ADS9324_VERSION_H
#define ADS9324_VERSION_H

/** Major version: incompatible API changes. */
#define ADS9324_VERSION_MAJOR @ADS9324_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define ADS9324_VERSION_MINOR @ADS9324_VERSION_MINOR@
/** Patch version: fixes. */
#define ADS9324_VERSION_PATCH @ADS9324_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define ADS9324_VERSION_STRING "@ADS9324_VERSION@"

#endif // ADS9324_VERSION_H
